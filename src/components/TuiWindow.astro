---
// TuiWindow.astro
//
// The hero card, built as an interactive TUI chat session after the terminal
// demo on https://dshtui.com. It opens with a scripted turn — an agent
// streaming a self-introduction as an object literal — and then hands the
// prompt to the visitor.
//
// The agent is a fixture, not a model: every question returns the contact
// card, and the reply says so rather than pretending to have understood.
// The "simulated session" caption under the card marks the whole thing as
// staged, mirroring the reference's own note.
//
// The opening transcript is rendered server-side in full, so crawlers and
// no-JS visitors get the text. The typewriter blanks only its text nodes and
// refills them, leaving the coloured spans in place, which is how the reveal
// keeps its syntax colour. `html.js`, set by Layout before first paint, hides
// the stream until the script arms it so the finished text never flashes.

// Lines are [class, text] tuples rather than markup because Astro strips
// whitespace-only text nodes from templates, which eats every indent.
// Expression strings survive verbatim.
type Line = [string, string][];

const bannerRows = [
  '█  █  █   █',
  '█ █    █ █ ',
  '██      █  ',
  '█ █     █  ',
  '█  █    █  ',
];

const agentLines: Line[] = [
  [['k', 'const'], ['p', ' '], ['i', 'kaiwen'], ['p', ' = '], ['p', '{']],
  [['p', '  '], ['i', 'role'], ['p', ':    '], ['s', "'MSc CS @ UCD · Backend & Full-Stack'"], ['p', ',']],
  [['p', '  '], ['i', 'stack'], ['p', ':   '], ['b', '['], ['s', "'Java'"], ['p', ', '], ['s', "'Spring Boot'"], ['p', ', '], ['s', "'Go'"], ['p', ', '], ['s', "'FastAPI'"], ['p', ',']],
  [['p', '            '], ['s', "'React'"], ['p', ', '], ['s', "'TypeScript'"], ['p', ', '], ['s', "'PostgreSQL'"], ['b', ']'], ['p', ',']],
  [['p', '  '], ['i', 'focus'], ['p', ':   '], ['s', "'Reliable systems, clear APIs, AI features'"], ['p', ',']],
  [['p', '  '], ['i', 'contact'], ['p', ': '], ['s', "'kaiwen.yao.ie@gmail.com'"], ['p', ',']],
  [['p', '};']],
];

const replyLines: Line[] = [
  [['k', 'const'], ['p', ' '], ['i', 'contact'], ['p', ' = '], ['p', '{']],
  [['p', '  '], ['i', 'email'], ['p', ':    '], ['s', "'kaiwen.yao.ie@gmail.com'"], ['p', ',']],
  [['p', '  '], ['i', 'github'], ['p', ':   '], ['s', "'github.com/kaiwenyao'"], ['p', ',']],
  [['p', '  '], ['i', 'linkedin'], ['p', ': '], ['s', "'linkedin.com/in/kaiwen-yao-356385366'"], ['p', ',']],
  [['p', '};']],
];

const statusRows = [
  { chip: 'agent', mid: 'idle', right: 'ctx 1.2k/200k 0.6%' },
  { left: 'portfolio-agent · max · 1.2k→412', right: 'main · portfolio' },
  { left: '0 errors · 0 tools · 1 message', right: '? for shortcuts' },
];
---

<div class="tui">
  <div class="tui-halo" aria-hidden="true"></div>

  <div class="tui-frame">
    <div class="tui-chrome">
      <span class="light light-close" aria-hidden="true"></span>
      <span class="light light-min" aria-hidden="true"></span>
      <span class="light light-max" aria-hidden="true"></span>
      <span class="chrome-title">kaiwen-tui — fullscreen · 96×28</span>
      <span class="chrome-meta">portfolio v1.0</span>
    </div>

    <div class="tui-banner">
      <pre class="banner-mark" aria-hidden="true">{bannerRows.join('\n')}</pre>
      <div class="banner-text">
        <div class="banner-word">KAIWEN YAO</div>
        <div class="banner-lines">
          <div><span class="t-text">portfolio-agent</span> <span class="t-faint">· Max effort</span></div>
          <div class="t-dim">~/portfolio</div>
          <div class="t-dim">
            Tip: <span class="t-accent">/about</span> · <span class="t-accent">/stack</span> ·
            <span class="t-accent">/contact</span> · Tab to complete
          </div>
        </div>
      </div>
    </div>
    <div class="tui-tagline">BUILDING RELIABLE SYSTEMS</div>

    <div class="tui-stream" role="log" aria-live="polite">
      <div class="tui-user"><span class="user-sigil">&gt;</span><span class="user-text">tell me about yourself</span></div>

      <div class="tui-thinking" hidden><span class="spinner">⠋</span> thinking…</div>

      <div class="tui-agent">
        {agentLines.map((line) => (
          <div>{line.map(([cls, text]) => <span class={cls}>{text}</span>)}</div>
        ))}
      </div>

      <span class="tui-caret" aria-hidden="true"></span>
    </div>

    <form class="tui-prompt" autocomplete="off">
      <span class="prompt-sigil" aria-hidden="true">&gt;</span>
      <span class="prompt-idle" aria-hidden="true"></span>
      <input
        class="prompt-input"
        type="text"
        name="question"
        maxlength="120"
        placeholder="ask me anything"
        aria-label="Ask the portfolio agent"
      />
      <span class="prompt-hint" aria-hidden="true">↵</span>
    </form>

    <div class="tui-status">
      {statusRows.map((row) => (
        <div class="status-row">
          {row.chip
            ? <span class="status-chip">{row.chip}</span>
            : <span class="status-left t-text truncate">{row.left}</span>}
          {row.mid && <span class="t-faint status-wide">{row.mid}</span>}
          <span class="status-right">{row.right}</span>
        </div>
      ))}
    </div>
  </div>

  <p class="tui-note">↑ simulated session · every question returns the contact card</p>

  <template class="tui-question-template">
    <div class="tui-user"><span class="user-sigil">&gt;</span><span class="user-text"></span></div>
  </template>

  <template class="tui-reply-template">
    <div class="tui-agent">
      <div class="lead"><span class="d">⏺ I'm a fixture, not a model — here's how to reach the real one:</span></div>
      {replyLines.map((line) => (
        <div>{line.map(([cls, text]) => <span class={cls}>{text}</span>)}</div>
      ))}
    </div>
  </template>
</div>

<style>
  .tui {
    --term-bg: #fafaf7;
    --term-chrome: #f0f0ea;
    --term-status: #eef0f4;
    --term-userbar: #f6efdb;
    --term-line: #e2e5ee;
    --term-text: #263146;
    --term-dim: #66718a;
    --term-faint: #98a1b6;
    --term-accent: #3b53c2;
    --term-chip: #4b6fff;
    --term-shadow: 0 24px 70px -18px rgba(23, 37, 84, 0.28);
    --term-shadow-lift: 0 34px 86px -16px rgba(23, 37, 84, 0.36);
    --halo: rgba(75, 111, 255, 0.1);
    --halo-lift: rgba(75, 111, 255, 0.17);

    --tok-key: #9b3bb0;
    --tok-ident: #3b53c2;
    --tok-str: #0f7a43;
    --tok-brack: #a8560f;
    --tok-punc: #66718a;

    --ease-out-quint: cubic-bezier(0.16, 1, 0.3, 1);

    position: relative;
    width: 100%;
    max-width: 48rem;
    min-width: 0;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    animation: window-in 0.6s var(--ease-out-quint) both;
  }

  .tui-halo {
    position: absolute;
    inset: -1.5rem;
    border-radius: 1rem;
    background: radial-gradient(closest-side, var(--halo), transparent);
    pointer-events: none;
    transition: background 0.45s ease;
  }

  .tui-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--term-line);
    border-radius: 0.5rem;
    background: var(--term-bg);
    box-shadow: var(--term-shadow);
    transition:
      transform 0.45s var(--ease-out-quint),
      box-shadow 0.45s var(--ease-out-quint);
  }

  /* ---- Title bar ---- */
  .tui-chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    background: var(--term-chrome);
    border-bottom: 1px solid var(--term-line);
  }

  .light {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 9999px;
    opacity: 0.8;
    transition: opacity 0.35s ease;
  }
  .light-close { background: #f0685f; }
  .light-min { background: #f5c542; }
  .light-max { background: #3ddc84; }

  .chrome-title {
    margin-left: 0.5rem;
    font-size: 11px;
    color: var(--term-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chrome-meta {
    display: none;
    margin-left: auto;
    font-size: 11px;
    color: var(--term-faint);
    white-space: nowrap;
  }

  /* ---- Banner ---- */
  .tui-banner {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 1rem 0;
  }

  .banner-mark {
    margin: 0;
    color: var(--term-accent);
    font-size: 9px;
    line-height: 1.15;
    white-space: pre;
    flex-shrink: 0;
  }

  .banner-word {
    color: var(--term-accent);
    font-size: clamp(15px, 2.6vw, 22px);
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.3;
  }

  .banner-lines {
    margin-top: 0.5rem;
    font-size: 11px;
    line-height: 1.7;
  }

  .tui-tagline {
    padding: 0.75rem 1rem 0;
    color: var(--term-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.3em;
  }

  .t-text { color: var(--term-text); }
  .t-dim { color: var(--term-dim); }
  .t-faint { color: var(--term-faint); }
  .t-accent { color: var(--term-accent); }

  /* ---- Transcript ---- */
  .tui-stream {
    height: 200px;
    margin-top: 0.75rem;
    padding: 0 1rem;
    overflow: auto;
    color: var(--term-text);
    font-size: 12px;
    line-height: 1.85;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: var(--term-line) transparent;
  }

  /* Armed once the script has blanked the text nodes, so the finished
     transcript never flashes before the reveal starts. */
  :global(html.js) .tui-stream { visibility: hidden; }
  :global(html.js) .tui-stream.is-armed { visibility: visible; }

  .tui-user {
    margin-bottom: 0.5rem;
    padding: 0.25rem 0.5rem;
    background: var(--term-userbar);
    border-radius: 0.125rem;
    color: var(--term-text);
    overflow-wrap: anywhere;
  }

  .user-sigil {
    margin-right: 0.4em;
    color: var(--term-accent);
    font-weight: 700;
  }

  .tui-thinking { color: var(--term-dim); }
  .tui-thinking[hidden] { display: none; }
  .spinner { color: var(--term-accent); }

  .tui-agent { margin-bottom: 0.5rem; }
  .tui-agent > div { white-space: pre; }
  .tui-agent .lead { white-space: normal; margin-bottom: 0.25rem; }

  .k { color: var(--tok-key); }
  .i { color: var(--tok-ident); }
  .s { color: var(--tok-str); }
  .b { color: var(--tok-brack); }
  .p { color: var(--tok-punc); }
  .d { color: var(--term-dim); }

  /* Only shown while the write head is moving — at rest the blinking cursor
     belongs in the prompt, not at the end of the last reply. */
  .tui-caret {
    display: none;
    width: 0.5em;
    height: 1.05em;
    background: var(--tok-ident);
    vertical-align: text-bottom;
    animation: caret-blink 1.1s step-start infinite;
  }
  .tui-caret.is-typing { display: inline-block; }

  /* ---- Prompt ---- */
  .tui-prompt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.625rem 1rem;
    padding: 0.375rem 0.5rem;
    border: 1px solid var(--term-line);
    border-radius: 0.25rem;
    background: #fff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .tui-prompt:focus-within {
    border-color: var(--term-accent);
    box-shadow: 0 0 0 2px rgba(75, 111, 255, 0.12);
  }

  .prompt-sigil {
    color: var(--term-accent);
    font-weight: 700;
    font-size: 12px;
  }

  .prompt-input {
    flex: 1;
    min-width: 0;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--term-text);
    caret-color: var(--term-accent);
    font: inherit;
    font-size: 12px;
    outline: none;
  }

  .prompt-input::placeholder { color: var(--term-faint); }

  /* Idle block cursor: the terminal look while nothing is typed. Once the
     field is focused or holds text, the native caret takes over. */
  .prompt-idle {
    display: inline-block;
    width: 0.5em;
    height: 1.05em;
    background: var(--term-accent);
    animation: caret-blink 1.1s step-start infinite;
  }
  .tui-prompt:focus-within .prompt-idle,
  .tui-prompt:has(.prompt-input:not(:placeholder-shown)) .prompt-idle { display: none; }

  .prompt-hint {
    color: var(--term-faint);
    font-size: 11px;
  }

  /* ---- Status strip ---- */
  .tui-status {
    padding: 0.375rem 0.75rem;
    border-top: 1px solid var(--term-line);
    background: var(--term-status);
    color: var(--term-dim);
    font-size: 10.5px;
    line-height: 1.75;
    user-select: none;
  }

  .status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .status-chip {
    border-radius: 0.125rem;
    padding: 0 0.375rem;
    background: var(--term-chip);
    color: #fff;
    font-weight: 500;
  }

  .status-right {
    white-space: nowrap;
    color: var(--term-faint);
  }
  .status-row:first-child .status-right { color: var(--term-text); }

  .truncate {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .status-wide { display: none; }

  .tui-note {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 11px;
    color: var(--term-faint);
  }

  @media (min-width: 640px) {
    .tui-banner { padding: 1.25rem 1.25rem 0; gap: 1.75rem; }
    .banner-mark { font-size: 11px; }
    .banner-lines { font-size: 12px; }
    .tui-tagline { padding: 0.75rem 1.25rem 0; font-size: 13px; }
    .tui-stream { height: 230px; padding: 0 1.25rem; font-size: 13px; }
    .tui-prompt { margin: 0.625rem 1.25rem; }
    .prompt-sigil, .prompt-input { font-size: 13px; }
    .tui-status { padding: 0.375rem 1rem; font-size: 11.5px; }
    .chrome-meta, .status-wide { display: block; }
  }

  /* ---- Interaction ---- */
  @media (hover: hover) {
    .tui:hover .tui-frame {
      transform: translateY(-4px);
      box-shadow: var(--term-shadow-lift);
    }
    .tui:hover .tui-halo {
      background: radial-gradient(closest-side, var(--halo-lift), transparent);
    }
    .tui:hover .light { opacity: 1; }
  }

  @keyframes window-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes caret-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tui { animation: none; }
    .tui-frame, .tui-halo, .light { transition: none; }
    .tui-caret, .prompt-idle { animation: none; }
    .tui-stream { scroll-behavior: auto; }
  }
</style>

<script>
  import { createTypewriter } from '../scripts/typewriter';

  const root = document.querySelector('.tui');
  if (root) {
    const stream = root.querySelector('.tui-stream') as HTMLElement;
    const agent = root.querySelector('.tui-agent') as HTMLElement;
    const thinking = root.querySelector('.tui-thinking') as HTMLElement;
    const spinner = root.querySelector('.spinner') as HTMLElement;
    const caret = root.querySelector('.tui-caret') as HTMLElement;
    const form = root.querySelector('.tui-prompt') as HTMLFormElement;
    const input = root.querySelector('.prompt-input') as HTMLInputElement;
    const replyTemplate = root.querySelector('.tui-reply-template') as HTMLTemplateElement;
    const questionTemplate = root.querySelector('.tui-question-template') as HTMLTemplateElement;
    const counter = root.querySelector('.tui-status .status-row:last-child .status-left');

    const THINK_DELAY_MS = 700;
    const SPINNER_INTERVAL_MS = 80;
    const SPINNER_FRAMES = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let isBusy = true;
    let messageCount = 1;

    const scrollToEnd = () => { stream.scrollTop = stream.scrollHeight; };

    function setCounter() {
      if (!counter) return;
      const noun = messageCount === 1 ? 'message' : 'messages';
      counter.textContent = `0 errors · 0 tools · ${messageCount} ${noun}`;
    }

    function settle() {
      isBusy = false;
      caret.classList.remove('is-typing');
      scrollToEnd();
    }

    function streamBlock(block: Element) {
      caret.classList.add('is-typing');
      const writer = createTypewriter(block, caret, {
        onAdvance: scrollToEnd,
        onDone: settle,
      });
      if (reduceMotion) writer.reveal();
      else writer.play();
    }

    // Braille spinner, then the callback. Reduced motion skips straight through.
    function think(next: () => void) {
      if (reduceMotion) {
        next();
        return;
      }
      thinking.hidden = false;
      scrollToEnd();
      let frame = 0;
      const spin = window.setInterval(() => {
        frame = (frame + 1) % SPINNER_FRAMES.length;
        spinner.textContent = SPINNER_FRAMES[frame];
      }, SPINNER_INTERVAL_MS);
      window.setTimeout(() => {
        window.clearInterval(spin);
        thinking.hidden = true;
        next();
      }, THINK_DELAY_MS);
    }

    function appendQuestion(text: string) {
      const line = questionTemplate.content.firstElementChild?.cloneNode(true) as Element | undefined;
      if (!line) return;
      // textContent, never innerHTML — typed input is never parsed as markup.
      const slot = line.querySelector('.user-text');
      if (slot) slot.textContent = text;
      stream.appendChild(line);
    }

    function answer() {
      const reply = replyTemplate.content.firstElementChild?.cloneNode(true) as Element | undefined;
      if (!reply) {
        settle();
        return;
      }
      stream.appendChild(reply);
      streamBlock(reply);
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const question = input.value.trim();
      if (!question || isBusy) return;

      isBusy = true;
      input.value = '';
      appendQuestion(question);
      messageCount += 2;
      setCounter();
      stream.appendChild(thinking);
      scrollToEnd();
      think(answer);
    });

    // Built up front so the opening turn can be blanked before the stream is
    // made visible — otherwise the finished text shows through the think.
    const opening = createTypewriter(agent, caret, {
      onAdvance: scrollToEnd,
      onDone: settle,
    });

    if (reduceMotion) {
      stream.classList.add('is-armed');
      opening.reveal();
    } else {
      opening.blank();
      stream.classList.add('is-armed');

      // Hold the opening turn until the card is on screen, so a visitor
      // landing mid-page still sees it play rather than arriving finished.
      const openingTurn = () => think(() => {
        caret.classList.add('is-typing');
        opening.play();
      });

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          if (!entries[0].isIntersecting) return;
          observer.disconnect();
          openingTurn();
        }, { threshold: 0.25 });
        observer.observe(root);
      } else {
        openingTurn();
      }
    }
  }
</script>
