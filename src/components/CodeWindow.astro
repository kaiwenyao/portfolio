---
// CodeWindow.astro
//
// The hero's code card, restyled after the terminal window on
// https://dshtui.com: warm paper chrome, a blueprint-blue lift, a mono
// title bar with dimmed traffic lights, and an editor status strip.
//
// The reference card is a TUI, so it reports terminal geometry
// ("fullscreen · 120×36") and a runtime chip. This one holds a source file,
// so it borrows the *form* — dash and middot separators, faint mono, a
// coloured chip on a dense status strip — and fills it with editor facts
// instead of pretending to be a terminal.
//
// Interactions, all dropped under `prefers-reduced-motion` and gated on
// `hover: hover` so touch devices never latch a hover state:
//   * one-shot entrance: the window rises and fades in
//   * hover: the frame lifts, its shadow deepens, the halo warms and the
//     traffic lights come up from 80% to full colour
//   * a caret blinking after the closing brace
---

<div class="code-window">
  <div class="code-halo" aria-hidden="true"></div>

  <div class="code-frame">
    <div class="code-chrome">
      <span class="light light-close" aria-hidden="true"></span>
      <span class="light light-min" aria-hidden="true"></span>
      <span class="light light-max" aria-hidden="true"></span>
      <span class="chrome-title">coder.js — javascript · utf-8</span>
      <span class="chrome-meta">kaiwenyao.dev</span>
    </div>

    <div class="code-body">
      <div class="code-lines">
        <div><span class="tok-key">const</span> <span class="tok-ident">coder</span> <span class="tok-punc">=</span> <span class="tok-punc">&#123;</span></div>
        <div class="indent-1"><span class="tok-ident">name</span><span class="tok-punc">:</span> <span class="tok-str">'Kaiwen Yao'</span><span class="tok-punc">,</span></div>
        <div class="indent-1"><span class="tok-ident">focus</span><span class="tok-punc">:</span> <span class="tok-str">'Backend &amp; full-stack systems'</span><span class="tok-punc">,</span></div>
        <div class="indent-1"><span class="tok-ident">stack</span><span class="tok-punc">:</span> <span class="tok-brack">[</span><span class="tok-str">'Java'</span><span class="tok-punc">,</span> <span class="tok-str">'Spring Boot'</span><span class="tok-punc">,</span> <span class="tok-str">'Go'</span><span class="tok-punc">,</span> <span class="tok-str">'FastAPI'</span><span class="tok-punc">,</span></div>
        <div class="indent-2"><span class="tok-str">'React'</span><span class="tok-punc">,</span> <span class="tok-str">'TypeScript'</span><span class="tok-punc">,</span> <span class="tok-str">'PostgreSQL'</span><span class="tok-punc">,</span> <span class="tok-str">'Docker'</span><span class="tok-brack">]</span><span class="tok-punc">,</span></div>
        <div class="indent-1"><span class="tok-ident">building</span><span class="tok-punc">:</span> <span class="tok-str">'Reliable APIs, data products, AI features'</span><span class="tok-punc">,</span></div>
        <div class="indent-1"><span class="tok-ident">availableFor</span><span class="tok-punc">:</span> <span class="tok-punc">()</span> <span class="tok-key">=&gt;</span> <span class="tok-punc">&#123;</span></div>
        <div class="indent-2"><span class="tok-key">return</span></div>
        <div class="indent-3"><span class="tok-punc">(</span></div>
        <div class="indent-3"><span class="tok-str">'Backend Engineering'</span></div>
        <div class="indent-3"><span class="tok-brack">||</span> <span class="tok-str">'Full-Stack Development'</span></div>
        <div class="indent-3"><span class="tok-brack">||</span> <span class="tok-str">'AI-enabled Products'</span></div>
        <div class="indent-3"><span class="tok-punc">);</span></div>
        <div class="indent-2"><span class="tok-punc">&#125;</span></div>
        <div><span class="tok-punc">&#125;;</span><span class="caret" aria-hidden="true"></span></div>
      </div>
    </div>

    <div class="code-status">
      <span class="status-chip">JS</span>
      <span class="status-faint status-wide">UTF-8</span>
      <span class="status-faint status-wide">LF</span>
      <span class="status-gap"></span>
      <span>Ln 15, Col 3</span>
      <span class="status-faint status-wide">Spaces: 2</span>
    </div>
  </div>
</div>

<style>
  .code-window {
    /* Terminal chrome, carried over from the reference site. */
    --term-bg: #fafaf7;
    --term-chrome: #f0f0ea;
    --term-status: #eef0f4;
    --term-line: #e2e5ee;
    --term-text: #263146;
    --term-dim: #66718a;
    --term-faint: #98a1b6;
    --term-chip: #4b6fff;
    --term-shadow: 0 24px 70px -18px rgba(23, 37, 84, 0.28);
    --term-shadow-lift: 0 34px 86px -16px rgba(23, 37, 84, 0.36);
    --halo: rgba(75, 111, 255, 0.1);
    --halo-lift: rgba(75, 111, 255, 0.17);

    /* Syntax, pulled toward the blueprint blue so the card and the page
       background read as one palette rather than two. */
    --tok-key: #9b3bb0;
    --tok-ident: #3b53c2;
    --tok-str: #0f7a43;
    --tok-brack: #a8560f;
    --tok-punc: #66718a;

    --ease-out-quint: cubic-bezier(0.16, 1, 0.3, 1);

    position: relative;
    width: 100%;
    max-width: 48rem;
    min-width: 0;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    animation: window-in 0.6s var(--ease-out-quint) both;
  }

  /* Soft bloom bleeding out past the frame, tying the card to the grid. */
  .code-halo {
    position: absolute;
    inset: -1.5rem;
    border-radius: 1rem;
    background: radial-gradient(closest-side, var(--halo), transparent);
    pointer-events: none;
    transition: background 0.45s ease;
  }

  .code-frame {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--term-line);
    border-radius: 0.5rem;
    background: var(--term-bg);
    box-shadow: var(--term-shadow);
    transition:
      transform 0.45s var(--ease-out-quint),
      box-shadow 0.45s var(--ease-out-quint);
  }

  /* ---- Title bar ---- */
  .code-chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    background: var(--term-chrome);
    border-bottom: 1px solid var(--term-line);
  }

  .light {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 9999px;
    opacity: 0.8;
    transition: opacity 0.35s ease;
  }
  .light-close { background: #f0685f; }
  .light-min { background: #f5c542; }
  .light-max { background: #3ddc84; }

  .chrome-title {
    margin-left: 0.5rem;
    font-size: 11px;
    color: var(--term-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chrome-meta {
    display: none;
    margin-left: auto;
    font-size: 11px;
    color: var(--term-faint);
    white-space: nowrap;
  }

  /* ---- Code ---- */
  .code-body {
    padding: 1rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--term-text);
  }

  .code-lines > div {
    white-space: pre;
  }

  .indent-1 { padding-left: 1.5rem; }
  .indent-2 { padding-left: 2rem; }
  .indent-3 { padding-left: 2.5rem; }

  .tok-key { color: var(--tok-key); }
  .tok-ident { color: var(--tok-ident); }
  .tok-str { color: var(--tok-str); }
  .tok-brack { color: var(--tok-brack); }
  .tok-punc { color: var(--tok-punc); }

  .caret {
    display: inline-block;
    width: 0.5em;
    height: 1.05em;
    margin-left: 0.15em;
    background: var(--tok-ident);
    vertical-align: text-bottom;
    animation: caret-blink 1.1s step-start infinite;
  }

  /* ---- Status strip ---- */
  .code-status {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.375rem 0.875rem;
    border-top: 1px solid var(--term-line);
    background: var(--term-status);
    color: var(--term-dim);
    font-size: 11.5px;
    user-select: none;
  }

  .status-chip {
    border-radius: 0.125rem;
    padding: 1px 0.375rem;
    background: var(--term-chip);
    color: #fff;
    font-weight: 500;
  }

  .status-faint { color: var(--term-faint); }
  .status-gap { margin-left: auto; }
  .status-wide { display: none; }

  @media (min-width: 640px) {
    .code-body {
      padding: 1.25rem;
      font-size: 0.875rem;
    }
    .chrome-meta,
    .status-wide {
      display: block;
    }
  }

  /* ---- Interaction ---- */
  @media (hover: hover) {
    .code-window:hover .code-frame {
      transform: translateY(-4px);
      box-shadow: var(--term-shadow-lift);
    }
    .code-window:hover .code-halo {
      background: radial-gradient(closest-side, var(--halo-lift), transparent);
    }
    .code-window:hover .light {
      opacity: 1;
    }
  }

  @keyframes window-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes caret-blink {
    0%,
    49% { opacity: 1; }
    50%,
    100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .code-window { animation: none; }
    .code-frame,
    .code-halo,
    .light { transition: none; }
    .caret { animation: none; }
  }
</style>
