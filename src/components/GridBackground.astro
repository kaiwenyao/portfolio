---
// GridBackground.astro
//
// A static "blueprint" background modelled on https://dshtui.com: a flat
// porcelain tint, a 56px engineering grid, one soft radial glow, and a field
// of slowly twinkling pixel stars.
//
// Replaces the previous WebGL2 fluid-gradient background. This renders with
// zero JavaScript — the stars are emitted at build time and the twinkle is a
// pure CSS animation — so there is no canvas, no shader compile, no RAF loop
// to pause on tab hide, and nothing to fall back to when WebGL is missing.
//
// Tuning lives in the constants below and the custom properties on
// `.grid-root`; restyle there rather than editing the individual layer rules.

const STAR_COUNT = 28;
const STAR_SEED = 20260823;
const MAX_TWINKLE_DELAY_S = 3;
const DIM_STAR_PROBABILITY = 0.5;

// Deterministic PRNG (mulberry32). A plain Math.random() field would lay the
// stars out differently on every build and churn the generated HTML, so the
// seed keeps output reproducible.
function createRandom(seed: number): () => number {
  let state = seed >>> 0;
  return () => {
    state = (state + 0x6d2b79f5) >>> 0;
    let t = state;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const nextRandom = createRandom(STAR_SEED);

const stars = Array.from({ length: STAR_COUNT }, () => ({
  left: (nextRandom() * 100).toFixed(2),
  top: (nextRandom() * 100).toFixed(2),
  delay: (nextRandom() * MAX_TWINKLE_DELAY_S).toFixed(2),
  isDim: nextRandom() < DIM_STAR_PROBABILITY,
}));
---

<div class="grid-root" aria-hidden="true">
  <div class="grid-lines"></div>
  <div class="grid-glow"></div>
  {stars.map((star) => (
    <span
      class:list={['star', { 'star-dim': star.isDim }]}
      style={`left:${star.left}%;top:${star.top}%;animation-delay:${star.delay}s`}
    ></span>
  ))}
</div>

<style>
  .grid-root {
    /* Palette carried over from the reference site's blueprint blue. */
    --grid-size: 56px;
    --grid-line: rgba(75, 111, 255, 0.09);
    --grid-tint: #f6f7f9;
    --glow-color: rgba(75, 111, 255, 0.1);
    --star-color: #4861cf;
    --star-color-dim: #9db8ff;
    --star-size: 3px;
    --star-opacity-min: 0.15;
    --star-opacity-max: 0.9;
    --twinkle-duration: 3s;

    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background-color: var(--grid-tint);
  }

  /* Two 1px rules crossed into an engineering grid. */
  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
  }

  /* A single wide bloom behind the hero, keeping the top of the page warmer
     than the fold so the grid does not read as a flat sheet. */
  .grid-glow {
    position: absolute;
    top: -10%;
    left: 50%;
    width: min(1100px, 120vw);
    aspect-ratio: 1 / 1;
    transform: translateX(-50%);
    background: radial-gradient(circle, var(--glow-color), transparent 70%);
  }

  .star {
    position: absolute;
    width: var(--star-size);
    height: var(--star-size);
    background: var(--star-color);
    opacity: var(--star-opacity-min);
    animation: twinkle var(--twinkle-duration) ease-in-out infinite;
  }

  .star-dim {
    background: var(--star-color-dim);
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: var(--star-opacity-min);
    }
    50% {
      opacity: var(--star-opacity-max);
    }
  }

  /* Hold the stars at a steady mid brightness instead of pulsing. */
  @media (prefers-reduced-motion: reduce) {
    .star {
      animation: none;
      opacity: 0.35;
    }
  }
</style>
