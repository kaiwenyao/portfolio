---
import Layout from '../layouts/Layout.astro';
import GridBackground from '../components/GridBackground.astro';
import TuiWindow from '../components/TuiWindow.astro';

const persona = {
  name: "Kaiwen Yao",
  title: "MSc Computer Science Student / Backend & Full-Stack Developer",
  intro: "MSc Computer Science student at University College Dublin with an engineering background from Beihang University. I build production-style backend and full-stack applications with Java, Spring Boot, Go, FastAPI, React, TypeScript, MySQL, PostgreSQL, Redis, Kafka, Docker, and Kubernetes, with a focus on reliable systems, clear APIs, and AI-enabled software products.",
  skills: [
    { name: "Java", icon: "java" },
    { name: "Go", icon: "go" },
    { name: "TypeScript", icon: "typescript" },
    { name: "Python", icon: "python" },
    { name: "C++", icon: "cplusplus" },
    { name: "Spring Boot", icon: "springboot" },
    { name: "FastAPI", icon: "fastapi" },
    { name: "Kafka", icon: "kafka" },
    { name: "Redis", icon: "redis" },
    { name: "MySQL", icon: "mysql" },
    { name: "PostgreSQL", icon: "postgresql" },
    { name: "React", icon: "react" },
    { name: "Vue", icon: "vue" },
    { name: "Next.js", icon: "nextjs" },
    { name: "Tailwind CSS", icon: "tailwind" },
    { name: "Docker", icon: "docker" },
    { name: "Kubernetes", icon: "kubernetes" },
    { name: "Jenkins", icon: "jenkins" },
    { name: "Git", icon: "git" },
  ],
  socials: [
    { name: "GitHub", url: "https://github.com/kaiwenyao", icon: "github" },
    { name: "LinkedIn", url: "https://www.linkedin.com/in/kaiwen-yao-356385366/", icon: "linkedin" },
    { name: "Email", url: "mailto:kaiwen.yao.ie@gmail.com", icon: "mail" },
  ],
  education: [
    {
      period: "Sep 2025 - Dec 2026",
      degree: "Master of Computer Science",
      school: "University College Dublin",
      description: "Dublin, Ireland"
    },
    {
      period: "Sep 2021 - Sep 2025",
      degree: "Bachelor of Power Engineering of Flight Vehicles",
      school: "Beihang University",
      description: "Beijing, China · Chinese Government Scholarship (2023) · Academic Excellence Scholarship, 2nd Prize (2024)"
    }
  ],
  experience: [
    {
      period: "Mar 2026 - Jun 2026",
      role: "Software Engineer Intern",
      company: "TrueMoment — Snowfall Ltd",
      bullets: [
        "Built TrueMoment, a low-pressure social platform for sharing spontaneous moments through dual-camera photos, developing the backend API end-to-end with Go, Gin, GORM, and MySQL.",
        "Implemented 9 production modules across authentication, posts, feeds, social interactions, notifications, and search.",
        "Applied a layered Handler → Service → Repository architecture with JWT authentication and Redis token revocation.",
        "Integrated AliCloud OSS + CDN for scalable media storage and delivery, with cursor-paginated feed APIs.",
        "Delivered production deployment with automated unit/integration testing, AliCloud Yunxiao CI/CD, ACR image publishing, and main-branch deployments."
      ]
    }
  ],
  projects: [
    {
      name: "EventPulse",
      tag: "AI-Powered Distributed Event Ticketing Platform",
      period: "2025 - 2026",
      tech: ["React", "Spring Boot", "PostgreSQL", "Kafka", "Redis", "Kubernetes", "FastAPI", "LangChain", "SeaweedFS", "Argo CD"],
      bullets: [
        "Built a distributed ticketing platform with React, Spring Boot, PostgreSQL, Kafka, Redis, and Kubernetes, using independently deployable API/worker services. Implemented Kafka-based booking, wallet, and cart workflows with Transactional Outbox, idempotent consumers, partition ordering, and broker-failure recovery.",
        "Implemented multi-replica SSE delivery with Kubernetes Services and Redis Pub/Sub, supporting cross-instance event propagation and reconnect backfill. Deployed SeaweedFS as S3-compatible storage with direct/proxied delivery, soft deletion, and asynchronous cleanup.",
        "Built a FastAPI + LangChain AI service for event discovery and copywriting, with service authentication and rate limiting. Enforced quality gates with Checkstyle, SpotBugs, and ESLint across GitHub Actions and Jenkins; tested distributed workflows with Testcontainers and Playwright, with GitOps deployments via Argo CD."
      ],
      url: "https://eventpulse.kaiwen.dev/",
      highlight: "Distributed Kafka workflows with Transactional Outbox and GitOps deployments"
    },
    {
      name: "Firmament Take-Out",
      tag: "Full-Stack Food Delivery Platform",
      period: "2025",
      tech: ["React 19", "TypeScript", "Spring Boot 3", "MyBatis Plus", "MySQL", "WebSocket", "Redis", "Docker", "Jenkins", "Kubernetes"],
      bullets: [
        "Designed separate React 19 + TypeScript applications for customers and merchants, with mobile-first ordering for customers and menu management, order fulfilment, and ECharts analytics for merchants. Isolated /user and /admin API routes with dedicated JWT interceptors, separate signing keys, and independent public-endpoint allowlists.",
        "Implemented WebSocket-based order updates and Redis caching, reducing average latency by 57.6% across 10,000 requests. Engineered transaction-safe ordering with server-side validation, atomic persistence, controlled state transitions, and automated cancellation of unpaid orders.",
        "Achieved 92.5% backend line coverage and 90%+ frontend statement coverage. Automated Docker CI/CD with Jenkins on Kubernetes, using ephemeral Maven/Node Pods for testing, image builds, and deployments."
      ],
      url: "https://firmament-admin.kaiwen.dev/",
      highlight: "57.6% lower average latency across 10,000 requests"
    },
    {
      name: "Dublin Bikes Assistant",
      tag: "Intelligent Bike-Sharing & Journey Planning Platform",
      period: "2025 - 2026",
      tech: ["React", "TypeScript", "Spring Boot", "Java 21", "PostgreSQL", "JPA", "Flyway", "FastAPI", "scikit-learn", "LangChain", "Jenkins", "Kubernetes"],
      bullets: [
        "Built a Python data ingestion pipeline for station availability and weather data, with independent polling, retry handling, transactional writes, and batched PostgreSQL retention cleanup.",
        "Built a LangChain + DeepSeek AI assistant with location-aware tool calling for live station availability, SSE streaming, and persistent chat history; integrated hourly scikit-learn availability forecasts. Built a journey optimiser that ranks nearby stations and uses Google Maps routing to minimise combined walking and cycling time.",
        "Separated prediction and conversational workloads into dedicated Python services behind a Spring Boot gateway centralising authentication, business rules, session ACLs, and internal-service access. Delivered five containerised services with Jenkins/Kubernetes CI/CD and quality gates with JUnit 5, Mockito, Testcontainers, and pytest."
      ],
      url: "https://bikes.kaiwen.dev",
      highlight: "Live conditions, hourly forecasts, optimised routes, and AI assistance"
    },
    {
      name: "UCDHub",
      tag: "Campus Community Platform with AI Advising",
      period: "2025 - 2026",
      tech: ["React", "TypeScript", "FastAPI", "SQLAlchemy 2.0", "Redis", "JWT", "Alibaba Cloud OSS", "Jenkins", "Kubernetes"],
      bullets: [
        "Built a React + TypeScript review attachment workflow with Alibaba Cloud OSS, supporting direct uploads, server-side validation, and time-limited presigned downloads.",
        "Built a tool-calling AI assistant for UCD course discovery, second-hand listings, and rentals, using an OpenAI-compatible LLM API with SSE streaming and Redis-backed chat history. Optimised search with Redis caching, reducing P95 latency by 92.1% (949.7 ms to 74.8 ms) and increasing throughput 11.95× in matched benchmarks with 10 concurrent clients.",
        "Designed a contribution-based access model and secured user-generated content with UCD email verification, rotating JWTs, Redis-backed revocation, rate limiting, and ownership checks. Containerised React/FastAPI services with Jenkins/Kubernetes CI/CD; built tests with pytest, Testcontainers, Vitest, and React Testing Library."
      ],
      url: "https://ucd-hub.com/",
      highlight: "Redis caching cut P95 search latency by 92.1% (949.7 ms → 74.8 ms)"
    }
  ]
};

const navItems = [
  { name: "ABOUT", href: "#about" },
  { name: "SKILLS", href: "#skills" },
  { name: "EDUCATION", href: "#education" },
  { name: "PROJECTS", href: "#projects" },
  { name: "INTERNSHIP", href: "#internship" },
  { name: "CONTACT", href: "#contact" },
];

const icons: Record<string, string> = {
  github: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`,
  linkedin: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  mail: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`,
  externalLink: `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>`,
  menu: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>`,
  close: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>`,
  arrow: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>`,
};
---

<Layout title={`${persona.name} - ${persona.title}`} description={persona.intro}>
  <!-- Static blueprint-grid background -->
  <GridBackground />

  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-xl border-b border-[#ececf1]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-4 flex items-center justify-between">
      <a href="/" class="text-lg font-bold text-[#0d0d0d] hover:text-[#5b5bf5] transition-colors">
        {persona.name}
      </a>

      <!-- Desktop Nav -->
      <ul class="hidden md:flex items-center gap-8">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class="text-sm text-[#6b6b6b] hover:text-[#5b5bf5] transition-colors duration-300 tracking-wider"
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile menu button -->
      <button id="menu-btn" class="md:hidden p-2 text-[#0d0d0d] hover:text-[#5b5bf5] transition-colors" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu" set:html={icons.menu} />
    </div>

    <!-- Mobile Nav -->
    <div id="mobile-menu" class="hidden md:hidden px-4 sm:px-6 pb-4 max-h-[70vh] overflow-y-auto">
      <ul class="flex flex-col gap-4">
        {navItems.map(item => (
          <li>
            <a
              href={item.href}
              class="text-sm text-[#6b6b6b] hover:text-[#5b5bf5] transition-colors block tracking-wider"
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <main class="relative z-10 pt-20">
    <!-- Hero Section -->
    <section id="about" class="min-h-[90vh] flex items-center px-4 sm:px-6 py-12 md:py-20 relative">
      <div class="max-w-7xl mx-auto w-full">
        <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
          <!-- Left: Personal Info -->
          <div class="stagger-children order-1">
            <p class="text-[#5b5bf5] text-sm tracking-[0.3em] mb-6 uppercase">Welcome to my portfolio</p>
            <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-[#0d0d0d] mb-6 leading-[1.1]">
              Hello, I'm<br />
              <span class="gradient-text">{persona.name}</span>
            </h1>
            <p class="text-lg sm:text-xl md:text-2xl text-[#3d3d3d] mb-8 leading-relaxed">
              {persona.title}
            </p>
            <p class="text-[#6b6b6b] mb-8 sm:mb-12 leading-relaxed">
              {persona.intro}
            </p>
            <div class="flex items-center gap-4 sm:gap-6">
              {persona.socials.map(social => (
                <a
                  href={social.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-3 rounded-xl bg-white border border-[#ececf1] text-[#3d3d3d] hover:text-[#5b5bf5] hover:border-[#5b5bf5] transition-all duration-300 hover:scale-110"
                  aria-label={social.name}
                  set:html={icons[social.icon]}
                />
              ))}
            </div>
          </div>

          <!-- Right: Simulated TUI session -->
          <div class="order-2 flex lg:justify-start lg:ml-12 min-w-0">
            <TuiWindow />
          </div>
        </div>
      </div>
    </section>


    <!-- Skills Marquee Section -->
    <section id="skills" class="py-16 relative overflow-hidden">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-[#0d0d0d] text-center mb-4">SKILLS</h2>
        <p class="text-[#6b6b6b] text-center">Technologies I work with</p>
      </div>

      <!-- Marquee Container (auto-scrolls by default; mouse-draggable) -->
      <div id="skills-marquee" class="marquee-scroll relative overflow-x-auto overflow-y-hidden py-2 cursor-grab">
        <div class="flex gap-4 flex-nowrap marquee-track select-none">
          {persona.skills.map((skill) => (
            <div class="skill-card flex flex-col items-center gap-3 px-4 py-4 md:px-5 md:py-5 bg-white border border-[#ececf1] rounded-xl min-w-[96px] md:min-w-[120px] shrink-0">
              <img
                src={`/skills/${skill.icon}.svg`}
                alt={skill.name}
                class="w-12 h-12 md:w-16 md:h-16 object-contain pointer-events-none"
                onerror={`this.src='/skills/${skill.icon}.png'`}
              />
              <span class="text-sm text-[#3d3d3d] font-medium">{skill.name}</span>
            </div>
          ))}
          {/* Second copy - for seamless loop */}
          <div class="flex gap-4 shrink-0" aria-hidden="true">
            {persona.skills.map((skill) => (
              <div class="skill-card flex flex-col items-center gap-3 px-4 py-4 md:px-5 md:py-5 bg-white border border-[#ececf1] rounded-xl min-w-[96px] md:min-w-[120px]">
                <img
                  src={`/skills/${skill.icon}.svg`}
                  alt={skill.name}
                  class="w-12 h-12 md:w-16 md:h-16 object-contain pointer-events-none"
                  onerror={`this.src='/skills/${skill.icon}.png'`}
                />
                <span class="text-sm text-[#3d3d3d] font-medium">{skill.name}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="section-divider mt-16 max-w-4xl mx-auto"></div>
    </section>

    <!-- Education Section -->
    <section id="education" class="py-20 px-4 sm:px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-[#0d0d0d] text-center mb-4">EDUCATION</h2>
        <p class="text-[#6b6b6b] text-center mb-12">My academic background</p>

        <div class="space-y-6">
          {persona.education.map((edu, i) => (
            <div class="glow-card">
              <div class="card p-6 relative">
                <div class="flex flex-col md:flex-row md:items-center gap-4">
                  <div class="flex-1">
                    <span class="text-[#8a8a8a] text-sm font-medium">{edu.period}</span>
                    <h3 class="text-xl font-bold text-[#0d0d0d] mt-2">{edu.degree}</h3>
                    <div class="text-[#5b5bf5] mt-1">{edu.school}</div>
                  </div>
                  <div class="text-[#6b6b6b] text-sm leading-relaxed md:text-right max-w-md">
                    {edu.description}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="py-20 px-4 sm:px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-[#0d0d0d] text-center mb-4">PROJECTS</h2>
        <p class="text-[#6b6b6b] text-center mb-12">Things I've built</p>

        <div class="space-y-8">
          {persona.projects.map((project) => (
            <div class="glow-card">
              <div class="card p-6 md:p-8">
                <!-- Header -->
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-4">
                  <div>
                    <h3 class="text-xl md:text-2xl font-bold text-[#0d0d0d]">{project.name}</h3>
                    <p class="text-[#5b5bf5] text-sm mt-1">{project.tag}</p>
                    <p class="text-[#8a8a8a] text-xs mt-1">{project.period}</p>
                  </div>
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#5b5bf5]/10 text-[#5b5bf5] text-sm hover:bg-[#5b5bf5]/20 transition-colors shrink-0"
                  >
                    <span class="w-4 h-4" set:html={icons.externalLink} />
                    Live Demo
                  </a>
                </div>

                <!-- Tech Tags -->
                <div class="flex flex-wrap gap-2 mb-5">
                  {project.tech.map((t) => (
                    <span class="px-2.5 py-1 bg-black/[0.03] text-[#3d3d3d] text-xs rounded-md border border-[#ececf1]">
                      {t}
                    </span>
                  ))}
                </div>

                <!-- Bullet Points -->
                <ul class="space-y-2.5">
                  {project.bullets.map((bullet) => (
                    <li class="flex items-start gap-3 text-[#6b6b6b] text-sm leading-relaxed">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#5b5bf5] mt-2 shrink-0" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>

                <!-- Highlight -->
                <div class="mt-5 pt-4 border-t border-[#ececf1] flex items-center gap-2 text-[#5b5bf5] text-sm">
                  <span class="w-4 h-4" set:html={icons.arrow} />
                  {project.highlight}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Internship Section -->
    <section id="internship" class="py-20 px-4 sm:px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-[#0d0d0d] text-center mb-4">INTERNSHIP</h2>
        <p class="text-[#6b6b6b] text-center mb-12">My internship experience</p>

        <div class="glow-card">
          <div class="card p-6 md:p-8">
            {persona.experience.map((exp) => (
              <div>
                <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-6 mb-4">
                  <span class="text-[#8a8a8a] text-sm font-medium">{exp.period}</span>
                  <div class="h-[1px] flex-1 bg-[#ececf1] hidden md:block"></div>
                </div>
                <h3 class="text-xl md:text-2xl font-bold text-[#0d0d0d]">{exp.role}</h3>
                <div class="text-[#5b5bf5] mt-1">{exp.company}</div>
                <ul class="space-y-2.5 mt-5">
                  {exp.bullets.map((bullet) => (
                    <li class="flex items-start gap-3 text-[#6b6b6b] text-sm leading-relaxed">
                      <span class="w-1.5 h-1.5 rounded-full bg-[#5b5bf5] mt-2 shrink-0" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="py-20 px-4 sm:px-6 relative">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="bg-orb bg-orb-violet w-[220px] h-[220px] md:w-[300px] md:h-[300px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>
      </div>

      <div class="max-w-2xl mx-auto text-center relative z-10">
        <h2 class="text-3xl md:text-4xl font-bold text-[#0d0d0d] mb-4">GET IN TOUCH</h2>
        <p class="text-[#6b6b6b] mb-12 leading-relaxed">
          I'm always open to discussing new projects, creative ideas,<br class="hidden md:block" />
          or opportunities to be part of your visions.
        </p>

        <a
          href="mailto:kaiwen.yao.ie@gmail.com"
          class="inline-flex items-center gap-3 px-8 py-4 bg-[#0d0d0d] text-white font-semibold rounded-xl hover:bg-[#5b5bf5] transition-all duration-300 hover:scale-105"
        >
          <span set:html={icons.mail} />
          Say Hello
        </a>

        <div class="flex items-center justify-center gap-6 mt-12">
          {persona.socials.map(social => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#6b6b6b] hover:text-[#5b5bf5] transition-colors duration-300 hover:scale-110"
              aria-label={social.name}
              set:html={icons[social.icon]}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="py-8 px-4 sm:px-6 border-t border-[#ececf1]">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-[#6b6b6b] text-sm">
          © {new Date().getFullYear()} Kaiwen Yao. All rights reserved.
        </p>
        <p class="text-[#6b6b6b] text-sm">
          Built with <span class="text-[#5b5bf5]">Astro</span> + <span class="text-[#4338ca]">Tailwind CSS</span>
        </p>
      </div>
    </footer>
  </main>
</Layout>

<style is:global>
  /* Skills marquee: hide scrollbar (still scrollable via JS + drag) */
  .marquee-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }
  .marquee-scroll::-webkit-scrollbar {
    display: none;
  }
  .marquee-scroll.dragging {
    cursor: grabbing;
  }
  /* Prevent native image ghost-drag interfering with mouse drag */
  .marquee-track img {
    -webkit-user-drag: none;
    user-drag: none;
  }
</style>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    menuBtn?.setAttribute('aria-expanded', String(!isHidden));
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });

  // Intersection Observer for fade-in animations
  const revealTargets = document.querySelectorAll('section > div');

  // Fallback: if IntersectionObserver is unavailable, reveal everything
  // immediately so content is never stuck hidden.
  if (!('IntersectionObserver' in window)) {
    revealTargets.forEach(el => el.classList.add('animate-fade-in-up'));
  } else {
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-fade-in-up');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    revealTargets.forEach(el => {
      observer.observe(el);
    });
  }

  // Skills marquee: continuous auto-scroll by default + mouse drag-to-scroll.
  // Both operate on scrollLeft so they never conflict; touch uses native scroll.
  const marquee = document.getElementById('skills-marquee');
  if (marquee) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const speedPxPerSec = 60; // ~ matches the previous 20s linear marquee feel
    let paused = false;            // hover-pause (mimics old hover behavior)
    let pointerActive = false;     // any pointer down (mouse/touch/pen)
    let mouseDragging = false;     // mouse is actively dragging
    let pointerId = null;
    let startX = 0;
    let startScrollLeft = 0;
    let lastTime = 0;

    // Wrap scrollLeft across the duplicated copy so the marquee loops
    // seamlessly in BOTH auto-scroll and drag directions (no end stop).
    // Because the track holds two identical copies, offset X and X +/- half
    // render identical content, so the wrap is visually invisible.
    function wrap() {
      const half = marquee.scrollWidth / 2;
      if (half <= 0) return;
      if (marquee.scrollLeft >= half) marquee.scrollLeft -= half;
      else if (marquee.scrollLeft < 0) marquee.scrollLeft += half;
    }

    // Time-based advance so speed is constant regardless of refresh rate.
    function frame(time) {
      const dt = time - lastTime;
      lastTime = time;
      if (!paused && !pointerActive && !prefersReducedMotion && dt > 0) {
        marquee.scrollLeft += speedPxPerSec * dt / 1000;
        wrap();
      }
      requestAnimationFrame(frame);
    }

    // Pause on hover (mouse) like the old hover-pause behavior
    marquee.addEventListener('mouseenter', () => { paused = true; });
    marquee.addEventListener('mouseleave', () => {
      if (!mouseDragging) paused = false;
    });

    marquee.addEventListener('pointerdown', (e) => {
      // Only primary mouse button initiates a JS drag; touch/pen use native scroll
      if (e.pointerType === 'mouse') {
        if (e.button !== 0) return;
        mouseDragging = true;
        pointerActive = true;
        marquee.classList.add('dragging');
        startX = e.clientX;
        startScrollLeft = marquee.scrollLeft;
        pointerId = e.pointerId;
        try { marquee.setPointerCapture(e.pointerId); } catch {}
        e.preventDefault();
      } else {
        // touch/pen: just pause auto-scroll while the native drag is active
        pointerActive = true;
      }
    });

    marquee.addEventListener('pointermove', (e) => {
      if (!mouseDragging) return;
      const half = marquee.scrollWidth / 2;
      if (half <= 0) return;
      // Compute the target from the current drag gesture, then modulo it into
      // one copy's width so the drag loops endlessly. Re-base the gesture to
      // the wrapped position every event: this keeps each per-event delta tiny
      // (instead of growing without bound from a fixed origin), which avoids
      // the repeat half-jumps that caused the stutter at the wrap point.
      let target = startScrollLeft - (e.clientX - startX);
      target = ((target % half) + half) % half;
      marquee.scrollLeft = target;
      startScrollLeft = target;
      startX = e.clientX;
    });

    const endDrag = (e) => {
      if (mouseDragging) {
        mouseDragging = false;
        marquee.classList.remove('dragging');
        if (pointerId !== null) {
          try { marquee.releasePointerCapture(pointerId); } catch {}
          pointerId = null;
        }
      }
      pointerActive = false;
      // keep paused while the cursor still hovers the marquee (hover-pause)
      if (!marquee.matches(':hover')) paused = false;
    };
    marquee.addEventListener('pointerup', endDrag);
    marquee.addEventListener('pointercancel', endDrag);

    if (!prefersReducedMotion) {
      requestAnimationFrame(frame);
    }
  }
</script>
